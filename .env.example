# 飞书应用凭证（从飞书开放平台获取）
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# 可选：飞书应用类型 (self_built / isv)
FEISHU_APP_TYPE=self_built

# 飞书多维表格 token（从 Base URL 解析: xxx.feishu.cn/base/<token>）
BITABLE_APP_TOKEN=your_bitable_app_token_here

# Obsidian vault 根路径
VAULT_ROOT=C:\path\to\your\vault
